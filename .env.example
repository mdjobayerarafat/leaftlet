# Template environment file — copy to .env.local and fill in real values.
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=main

# Server-only. Never expose to the browser.
APPWRITE_API_KEY=

APPWRITE_BOOKS_COLLECTION_ID=books
APPWRITE_AUTHORS_COLLECTION_ID=authors
APPWRITE_CATEGORIES_COLLECTION_ID=categories
APPWRITE_READING_PROGRESS_COLLECTION_ID=reading_progress
APPWRITE_BOOKMARKS_COLLECTION_ID=bookmarks
APPWRITE_NOTES_COLLECTION_ID=notes
APPWRITE_HIGHLIGHTS_COLLECTION_ID=highlights
APPWRITE_USER_LIBRARY_COLLECTION_ID=user_library
APPWRITE_READING_HISTORY_COLLECTION_ID=reading_history
APPWRITE_REVIEWS_COLLECTION_ID=reviews

APPWRITE_BOOK_PDFS_BUCKET_ID=book-pdfs
APPWRITE_BOOK_COVERS_BUCKET_ID=book-covers
APPWRITE_AUTHOR_IMAGES_BUCKET_ID=author-images
APPWRITE_CATEGORY_IMAGES_BUCKET_ID=category-images
APPWRITE_USER_AVATARS_BUCKET_ID=user-avatars

# AI book metadata generation via OpenRouter (server-only; optional).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
